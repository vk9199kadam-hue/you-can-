## Frontend (Vite) Firebase config
## Create a `.env` file (not committed) and fill these.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

## Optional: Firebase Functions region (if you set one later)
# VITE_FIREBASE_FUNCTIONS_REGION="us-central1"

## Optional: use Functions emulator in local dev
# VITE_USE_FUNCTIONS_EMULATOR="true"
# VITE_FUNCTIONS_EMULATOR_HOST="127.0.0.1"
# VITE_FUNCTIONS_EMULATOR_PORT="5001"

## Backend secrets (DO NOT put in VITE_ env vars)
## Use Firebase Functions config/params:
## - OPENAI_API_KEY
## - CLOUDFLARE_API_TOKEN
## - CLOUDFLARE_ACCOUNT_ID
